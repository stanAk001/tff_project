generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money values are whole naira (NGN), stored as integers.

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CollectionStatus {
  UPCOMING
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum HomepageSectionType {
  HERO
  MANIFESTO
  NEW_DROP
  CATEGORIES
  FEATURED_PRODUCTS
  FEATURED_COLLECTION
  EDITORIAL
  SHOP_THE_LOOK
  CAMPAIGN_BANNER
  LOOKBOOK
  NEWSLETTER
}

// ── People ───────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  wishlist  WishlistItem[]
  reviews   Review[]
  cart      Cart?
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  fullName   String
  phone      String
  line1      String
  city       String
  state      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ── Catalogue ────────────────────────────────────────────────────────────

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  videoUrl       String?
  position       Int      @default(0)
  // { columns: ["Size","Chest","Length"], rows: [["S","52","70"], ...], unit: "cm" }
  sizeGuide      Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
}

model Collection {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  coverImageUrl  String?
  coverVideoUrl  String?
  launchDate     DateTime?
  status         CollectionStatus @default(ACTIVE)
  // A drop is a limited, numbered release (DROP 001, DROP 002…)
  isDrop         Boolean          @default(false)
  dropNumber     Int?
  featured       Boolean          @default(false)
  published      Boolean          @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  products         CollectionProduct[]
  homepageSections HomepageCollection[]

  @@index([status, published])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  price          Int
  compareAtPrice Int?
  sku            String?       @unique
  categoryId     String?
  gender         Gender        @default(UNISEX)
  tags           String[]      @default([])
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  isNew          Boolean       @default(false)
  bestseller     Boolean       @default(false)
  limited        Boolean       @default(false)
  salesCount     Int           @default(0)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  videos           ProductVideo[]
  variants         ProductVariant[]
  collections      CollectionProduct[]
  reviews          Review[]
  wishlistedBy     WishlistItem[]
  lookbookItems    LookbookProduct[]
  homepageSections HomepageProduct[]
  orderItems       OrderItem[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([gender])
  @@index([price])
  @@index([salesCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String?
  alt       String?
  // Optional: ties an image to a colour so the gallery can follow the selected colour
  colour    String?
  width     Int?
  height    Int?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String?
  posterUrl String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Stock lives here — one row per colour/size combination.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  colour    String
  colourHex String   @default("#111111")
  size      String
  sku       String?  @unique
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  stockNotifications StockNotification[]

  @@unique([productId, colour, size])
  @@index([productId])
  @@index([stock])
}

// ── Cart & wishlist ──────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  // Guests are identified by an httpOnly cookie token; signed-in customers by customerId
  token      String?  @unique
  customerId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  variantId     String
  quantity      Int      @default(1)
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model WishlistItem {
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
}

// ── Orders ───────────────────────────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerId     String?
  // The cart this order was placed from — lets us clear it once payment succeeds
  cartId         String?
  email          String
  fullName       String
  phone          String
  addressLine    String
  city           String
  state          String
  deliveryOption String
  deliveryFee    Int         @default(0)
  subtotal       Int
  discountTotal  Int         @default(0)
  total          Int
  discountId     String?
  discountCode   String?
  status         OrderStatus @default(PENDING)
  // Stock is reserved when the order is created; this guards against releasing it twice
  stockReleased  Boolean     @default(false)
  trackingNumber String?
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount Discount?    @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payment  Payment?
  events   OrderEvent[]

  @@index([customerId])
  @@index([email])
  @@index([status, createdAt])
  @@index([createdAt])
}

// Name, price and variant are copied at purchase time so the order stays accurate
// even if the product is later edited or removed.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  name      String
  slug      String?
  colour    String
  size      String
  sku       String?
  imageUrl  String?
  unitPrice Int
  quantity  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  reference String        @unique
  provider  String        @default("paystack")
  amount    Int
  status    PaymentStatus @default(PENDING)
  channel   String?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Discount {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  // Percentage (1–100) or a fixed naira amount, depending on type
  value          Int
  minOrderAmount Int          @default(0)
  usageLimit     Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]
}

// ── Engagement ───────────────────────────────────────────────────────────

model Review {
  id         String       @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  title      String
  comment    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model StockNotification {
  id         String    @id @default(cuid())
  email      String
  variantId  String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([email, variantId])
  @@index([variantId, notifiedAt])
}

// ── Editorial ────────────────────────────────────────────────────────────

model Lookbook {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  season      String?
  description String?
  published   Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items LookbookItem[]
}

model LookbookItem {
  id         String    @id @default(cuid())
  lookbookId String
  mediaUrl   String?
  mediaType  MediaType @default(IMAGE)
  posterUrl  String?
  caption    String?
  // FULL | WIDE | TALL | HALF — controls how the image sits in the editorial layout
  layout     String    @default("FULL")
  position   Int       @default(0)

  lookbook Lookbook          @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  products LookbookProduct[]

  @@index([lookbookId, position])
}

// Links a product to a lookbook image. x/y (0–100 %) place the "Shop the Look" hotspot.
model LookbookProduct {
  id        String @id @default(cuid())
  itemId    String
  productId String
  x         Float?
  y         Float?
  position  Int    @default(0)

  item    LookbookItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([itemId, productId])
}

model HomepageSection {
  id       String              @id @default(cuid())
  type     HomepageSectionType @unique
  enabled  Boolean             @default(true)
  position Int                 @default(0)
  // Text, media and links for the section — shape depends on the type
  content  Json                @default("{}")

  products    HomepageProduct[]
  collections HomepageCollection[]
}

model HomepageProduct {
  sectionId String
  productId String
  position  Int    @default(0)

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sectionId, productId])
}

model HomepageCollection {
  sectionId    String
  collectionId String
  position     Int    @default(0)

  section    HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  collection Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([sectionId, collectionId])
}

// Store-wide settings editable from the admin (delivery options, policies, thresholds…)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
