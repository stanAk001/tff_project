# Where the API runs during development (the dev server proxies /api to it)
VITE_API_PROXY=http://localhost:4000

# Only needed when the storefront and API are deployed separately. They must then
# share a parent domain (e.g. tff.com and api.tff.com) so sign-in cookies are sent.
# Leave empty when the API serves the built storefront itself (the simplest setup).
VITE_API_URL=
